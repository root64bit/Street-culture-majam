# ==============================================================================
# STREET CULTURE - Environment Variables Template
# ==============================================================================

# Supabase Public Configuration (Accessible in Browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN0cmVldF9jdWx0dXJlIiwicm9sZSI6ImFub24iLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTkwMDAwMDAwMH0.local_anon_key

# Supabase Server-Only Secret Configuration (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN0cmVldF9jdWx0dXJlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTYwMDAwMDAwMCwiZXhwIjoxOTAwMDAwMDAwfQ.local_service_role_key

# PostgreSQL Connection Strings
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public support channels. Leave blank until each channel is active.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER="+27 66 548 8223"

# Twilio Email delivery and Supabase Auth's signed Send Email hook.
# Use a restricted Twilio key with Comms Email create/read and operation read only.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_EMAIL_FROM=support@streetculturevault.com
SUPABASE_SEND_EMAIL_HOOK_SECRET=
NEXT_PUBLIC_EMAIL_OTP_ENABLED=false
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
NEXT_PUBLIC_WHATSAPP_OTP_ENABLED=false
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# Newsletter signing key is separate from authentication credentials.
NEWSLETTER_SIGNING_SECRET=
MARKETING_POSTAL_ADDRESS=

# Future-order customer emails and admin alerts to support@streetculturevault.com.
# Also requires private per-channel DB activation cutoffs and the Supabase scheduler.
# Keep off in preview/staging; never backfill historical orders automatically.
ORDER_EMAILS_ENABLED=false
ORDER_NOTIFICATION_WORKER_SECRET=

# Internet Express uses Shiplogic. Keep this key server-only.
# The legacy local name api_internet_express_shipping is also supported.
INTERNET_EXPRESS_API_KEY=
# Collection details are read from the courier account's default collection address.
# These conservative defaults describe one packed item. Replace them with your
# actual packed measurements so live checkout quotes match the courier invoice.
INTERNET_EXPRESS_PARCEL_LENGTH_CM=35
INTERNET_EXPRESS_PARCEL_WIDTH_CM=25
INTERNET_EXPRESS_PARCEL_HEIGHT_CM=15
INTERNET_EXPRESS_PARCEL_WEIGHT_KG=2
# Leave false until Internet Express confirms liability cover on the account.
INTERNET_EXPRESS_LIABILITY_COVER_ENABLED=false

# Mozambique M-Pesa via the signed YAKA-owned gateway (guide 2 November 2026).
# The server sends the payment request; the customer confirms it on their phone.
# Orders above the 75,000 MZN provider limit are requested sequentially in
# installments of at most 75,000 MZN and are confirmed only after all succeed.
# Keep disabled until the Supabase guest-order migration and live listings are deployed.
MPESA_PAYMENTS_ENABLED=false
NEXT_PUBLIC_MPESA_PAYMENTS_ENABLED=false
MPESA_GATEWAY_URL=https://yaka-mpesa-gateway.vercel.app
MPESA_GATEWAY_EXPECTED_HOST=yaka-mpesa-gateway.vercel.app
MPESA_GATEWAY_ENV=production
# Application deadline: 1000-60000 ms; initiation includes a readiness check.
MPESA_GATEWAY_REQUEST_TIMEOUT_MS=20000
# Existing gateway credential, server-only. Do not generate an unrelated secret.
MPESA_GATEWAY_SHARED_SECRET=

# Retired gateway: new Square payments are blocked by provider-policy.ts even
# if an old deployment variable is true. Keep historical records intact.
SQUARE_PAYMENTS_ENABLED=false
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_PAYMENTS_ENABLED=false
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Retired PayFast virtual-wallet test tool: also blocked by provider-policy.ts.
# Sandbox credentials are independent of live merchant credentials.
# Do not set any NEXT_PUBLIC version of these values. Passphrase stays server-only.
PAYFAST_SANDBOX_ENABLED=false
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
PAYFAST_SANDBOX_SITE_URL=https://www.streetculturevault.com

# Docker / Container-to-Host Configuration
# When running Next.js inside Docker, use host.docker.internal to reach Supabase on the host machine:
# NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
