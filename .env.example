# ==============================================================================
# STREET CULTURE - Environment Variables Template
# ==============================================================================

# Supabase Public Configuration (Accessible in Browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN0cmVldF9jdWx0dXJlIiwicm9sZSI6ImFub24iLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTkwMDAwMDAwMH0.local_anon_key

# Supabase Server-Only Secret Configuration (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN0cmVldF9jdWx0dXJlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTYwMDAwMDAwMCwiZXhwIjoxOTAwMDAwMDAwfQ.local_service_role_key

# PostgreSQL Connection Strings
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Application Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public support channels. Leave blank until each channel is active.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Internet Express uses Shiplogic. Keep this key server-only.
# The legacy local name api_internet_express_shipping is also supported.
INTERNET_EXPRESS_API_KEY=
# Collection details are read from the courier account's default collection address.
# These conservative defaults describe one packed item. Replace them with your
# actual packed measurements so live checkout quotes match the courier invoice.
INTERNET_EXPRESS_PARCEL_LENGTH_CM=35
INTERNET_EXPRESS_PARCEL_WIDTH_CM=25
INTERNET_EXPRESS_PARCEL_HEIGHT_CM=15
INTERNET_EXPRESS_PARCEL_WEIGHT_KG=2
# Leave false until Internet Express confirms liability cover on the account.
INTERNET_EXPRESS_LIABILITY_COVER_ENABLED=false

# Mozambique M-Pesa via the merchant-approved MineScope middle server.
# The server sends the payment request; the customer confirms it on their phone.
# Orders above the 75,000 MZN provider limit are requested sequentially in
# installments of at most 75,000 MZN and are confirmed only after all succeed.
# Keep disabled until the Supabase guest-order migration and live listings are deployed.
MPESA_PAYMENTS_ENABLED=false
NEXT_PUBLIC_MPESA_PAYMENTS_ENABLED=false
MPESA_GATEWAY_BASE_URL=https://minescoop-mz.web.app/api/mpesa

# Square card processing is conditional on a valid merchant entity in a
# Square-supported country. Do not enable for a Mozambique-based seller.
SQUARE_PAYMENTS_ENABLED=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_PAYMENTS_ENABLED=false
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Docker / Container-to-Host Configuration
# When running Next.js inside Docker, use host.docker.internal to reach Supabase on the host machine:
# NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
